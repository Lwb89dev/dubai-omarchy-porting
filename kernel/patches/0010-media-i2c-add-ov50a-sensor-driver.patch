+static inline struct ov50a *to_ov50a(struct v4l2_subdev *sd)
+{
+	return container_of_const(sd, struct ov50a, sd);
+}
+
+static inline u32 ov50a_mode_hts(const struct ov50a_mode *mode)
+{
+	return mode->ppl * OV50A_HTS_UNIT;
+}
+
+static u32 ov50a_mbus_code(struct ov50a *ov50a)
+{
+	unsigned int idx = (ov50a->hflip->val << 1) | ov50a->vflip->val;
+
+	return ov50a_mbus_codes[idx];
+}
+
+static int ov50a_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov50a *ov50a = to_ov50a(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ov50a_supplies_tmpl),
+				    ov50a->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(ov50a->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable xclk: %d\n", ret);
+		goto err_reg;
+	}
+
+	fsleep(1000);
+	gpiod_set_value_cansleep(ov50a->reset_gpio, 0);
+	fsleep(5000);
+
+	return 0;
+
+err_reg:
+	regulator_bulk_disable(ARRAY_SIZE(ov50a_supplies_tmpl), ov50a->supplies);
+	return ret;
+}
+
+static int ov50a_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov50a *ov50a = to_ov50a(sd);
+
+	gpiod_set_value_cansleep(ov50a->reset_gpio, 1);
+	clk_disable_unprepare(ov50a->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(ov50a_supplies_tmpl), ov50a->supplies);
+
+	return 0;
+}
+
+static int ov50a_write_vts(struct ov50a *ov50a, u32 vts)
+{
+	int ret = 0;
+
+	cci_write(ov50a->regmap, OV50A_REG_VTS_H, (vts >> 16) & 0x0f, &ret);
+	cci_write(ov50a->regmap, OV50A_REG_VTS, vts & 0xffff, &ret);
+
+	return ret;
+}
+
+static int ov50a_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov50a *ov50a = container_of(ctrl->handler, struct ov50a,
+					  ctrl_handler);
+	const struct ov50a_mode *mode = ov50a->mode;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 exp_max = mode->height + ctrl->val - OV50A_EXPOSURE_MARGIN;
+		s64 exp_val = clamp_t(s64, ov50a->exposure->val,
+				      OV50A_EXPOSURE_MIN, exp_max);
+
+		__v4l2_ctrl_modify_range(ov50a->exposure, OV50A_EXPOSURE_MIN,
+					 exp_max, OV50A_EXPOSURE_STEP, exp_val);
+	}
+
+	if (pm_runtime_get_if_in_use(ov50a->dev) == 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(ov50a->regmap, OV50A_REG_ANALOGUE_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(ov50a->regmap, OV50A_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = ov50a_write_vts(ov50a, mode->height + ctrl->val);
+		break;
+	case V4L2_CID_HFLIP:
+		ret = cci_update_bits(ov50a->regmap, OV50A_REG_TIMING_CTRL_21,
+				      OV50A_FLIP_MASK,
+				      ctrl->val ? OV50A_FLIP_MASK : 0, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		/* Default tuned mode registers keep 0x3820[2] asserted. */
+		ret = cci_update_bits(ov50a->regmap, OV50A_REG_TIMING_CTRL_20,
+				      OV50A_FLIP_MASK,
+				      ctrl->val ? 0 : OV50A_FLIP_MASK, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(ov50a->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov50a_ctrl_ops = {
+	.s_ctrl = ov50a_set_ctrl,
+};
+
+static int ov50a_init_controls(struct ov50a *ov50a, u32 link_freq_bitmap)
+{
+	struct v4l2_ctrl_handler *hdl = &ov50a->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct ov50a_mode *mode = ov50a->mode;
+	u32 hblank, vblank, vblank_max, exp_max;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(ov50a->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	v4l2_ctrl_new_std(hdl, &ov50a_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  OV50A_PIXEL_RATE, OV50A_PIXEL_RATE, 1,
+			  OV50A_PIXEL_RATE);
+
+	ov50a->link_freq = v4l2_ctrl_new_int_menu(hdl, &ov50a_ctrl_ops,
+						  V4L2_CID_LINK_FREQ,
+						  fls(link_freq_bitmap) - 1,
+						  mode->link_freq_idx,
+						  ov50a_link_freq_menu);
+	if (ov50a->link_freq)
+		ov50a->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	hblank = ov50a_mode_hts(mode) - mode->width;
+	ov50a->hblank = v4l2_ctrl_new_std(hdl, &ov50a_ctrl_ops,
+					  V4L2_CID_HBLANK, hblank, hblank, 1,
+					  hblank);
+	if (ov50a->hblank)
+		ov50a->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts_def - mode->height;
+	vblank_max = OV50A_VTS_MAX - mode->height;
+	ov50a->vblank = v4l2_ctrl_new_std(hdl, &ov50a_ctrl_ops,
+					  V4L2_CID_VBLANK, OV50A_EXPOSURE_MARGIN,
+					  vblank_max, 1, vblank);
+
+	exp_max = mode->vts_def - OV50A_EXPOSURE_MARGIN;
+	ov50a->exposure = v4l2_ctrl_new_std(hdl, &ov50a_ctrl_ops,
+					    V4L2_CID_EXPOSURE,
+					    OV50A_EXPOSURE_MIN, exp_max,
+					    OV50A_EXPOSURE_STEP, exp_max);
+
+	v4l2_ctrl_new_std(hdl, &ov50a_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  OV50A_ANA_GAIN_MIN, OV50A_ANA_GAIN_MAX,
+			  OV50A_ANA_GAIN_STEP, OV50A_ANA_GAIN_DEFAULT);
+
+	ov50a->hflip = v4l2_ctrl_new_std(hdl, &ov50a_ctrl_ops, V4L2_CID_HFLIP,
+					 0, 1, 1, 0);
+	if (ov50a->hflip)
+		ov50a->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	ov50a->vflip = v4l2_ctrl_new_std(hdl, &ov50a_ctrl_ops, V4L2_CID_VFLIP,
+					 0, 1, 1, 0);
+	if (ov50a->vflip)
+		ov50a->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free_hdl;
+	}
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &ov50a_ctrl_ops, &props);
+	if (ret)
+		goto err_free_hdl;
+
+	ov50a->sd.ctrl_handler = hdl;
+
+	return 0;
+
+err_free_hdl:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int ov50a_enum_mbus_code(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct ov50a *ov50a = to_ov50a(sd);
+
+	if (code->index)
+		return -EINVAL;
+
+	code->code = ov50a_mbus_code(ov50a);
+
+	return 0;
+}
+
+static int ov50a_enum_frame_size(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct ov50a *ov50a = to_ov50a(sd);
+
+	if (fse->index >= ARRAY_SIZE(ov50a_modes))
+		return -EINVAL;
+
+	if (fse->code != ov50a_mbus_code(ov50a))
+		return -EINVAL;
+
+	fse->min_width = ov50a_modes[fse->index].width;
+	fse->max_width = ov50a_modes[fse->index].width;
+	fse->min_height = ov50a_modes[fse->index].height;
+	fse->max_height = ov50a_modes[fse->index].height;
+
+	return 0;
+}
+
+static void ov50a_update_pad_fmt(struct ov50a *ov50a,
+				 const struct ov50a_mode *mode,
+				 struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = ov50a_mbus_code(ov50a);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+}
+
+static int ov50a_set_pad_format(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_format *fmt)
+{
+	struct ov50a *ov50a = to_ov50a(sd);
+	const struct ov50a_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+
+	mode = v4l2_find_nearest_size(ov50a_modes, ARRAY_SIZE(ov50a_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	ov50a_update_pad_fmt(ov50a, mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		u32 hblank = ov50a_mode_hts(mode) - mode->width;
+		u32 vblank = mode->vts_def - mode->height;
+		u32 vblank_max = OV50A_VTS_MAX - mode->height;
+		u32 exp_max = mode->vts_def - OV50A_EXPOSURE_MARGIN;
+
+		ov50a->mode = mode;
+
+		__v4l2_ctrl_s_ctrl(ov50a->link_freq, mode->link_freq_idx);
+		__v4l2_ctrl_modify_range(ov50a->hblank, hblank, hblank, 1,
+					 hblank);
+		__v4l2_ctrl_modify_range(ov50a->vblank, OV50A_EXPOSURE_MARGIN,
+					 vblank_max, 1, vblank);
+		__v4l2_ctrl_s_ctrl(ov50a->vblank, vblank);
+		__v4l2_ctrl_modify_range(ov50a->exposure, OV50A_EXPOSURE_MIN,
+					 exp_max, OV50A_EXPOSURE_STEP, exp_max);
+	}
+
+	return 0;
+}
+
+static int ov50a_get_selection(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state,
+			       struct v4l2_subdev_selection *sel)
+{
+	struct ov50a *ov50a = to_ov50a(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = ov50a->mode->crop;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV50A_NATIVE_WIDTH;
+		sel->r.height = OV50A_NATIVE_HEIGHT;
+		return 0;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = OV50A_PIXEL_ARRAY_LEFT;
+		sel->r.top = OV50A_PIXEL_ARRAY_TOP;
+		sel->r.width = OV50A_PIXEL_ARRAY_WIDTH;
+		sel->r.height = OV50A_PIXEL_ARRAY_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int ov50a_init_state(struct v4l2_subdev *sd,
+			    struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = ov50a_modes[0].width,
+			.height = ov50a_modes[0].height,
+		},
+	};
+
+	ov50a_set_pad_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static int ov50a_enable_streams(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state, u32 pad,
+				u64 streams_mask)
+{
+	struct ov50a *ov50a = to_ov50a(sd);
+	const struct ov50a_mode *mode = ov50a->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ov50a->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_write(ov50a->regmap, OV50A_REG_SW_RESET,
+			OV50A_SW_RESET_TRIGGER, NULL);
+	if (ret)
+		goto err_power_off;
+
+	fsleep(5000);
+
+	ret = cci_multi_reg_write(ov50a->regmap, ov50a_init_regs,
+				  ARRAY_SIZE(ov50a_init_regs), NULL);
+	if (ret)
+		goto err_power_off;
+
+	ret = cci_multi_reg_write(ov50a->regmap, mode->reg_list.regs,
+				  mode->reg_list.num_regs, NULL);
+	if (ret)
+		goto err_power_off;
+
+	ret = __v4l2_ctrl_handler_setup(&ov50a->ctrl_handler);
+	if (ret)
+		goto err_power_off;
+
+	ret = cci_write(ov50a->regmap, OV50A_REG_STREAM_CTRL,
+			OV50A_STREAM_ON, NULL);
+	if (ret)
+		goto err_power_off;
+
+	__v4l2_ctrl_grab(ov50a->vflip, true);
+	__v4l2_ctrl_grab(ov50a->hflip, true);
+
+	return 0;
+
+err_power_off:
+	pm_runtime_put_autosuspend(ov50a->dev);
+	return ret;
+}
+
+static int ov50a_disable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct ov50a *ov50a = to_ov50a(sd);
+
+	cci_write(ov50a->regmap, OV50A_REG_STREAM_CTRL, OV50A_STREAM_OFF, NULL);
+	pm_runtime_put_autosuspend(ov50a->dev);
+
+	__v4l2_ctrl_grab(ov50a->vflip, false);
+	__v4l2_ctrl_grab(ov50a->hflip, false);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov50a_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov50a_pad_ops = {
+	.set_fmt = ov50a_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = ov50a_get_selection,
+	.enum_mbus_code = ov50a_enum_mbus_code,
+	.enum_frame_size = ov50a_enum_frame_size,
+	.enable_streams = ov50a_enable_streams,
+	.disable_streams = ov50a_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov50a_subdev_ops = {
+	.video = &ov50a_video_ops,
+	.pad = &ov50a_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov50a_internal_ops = {
+	.init_state = ov50a_init_state,
+};
+
+static const struct media_entity_operations ov50a_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int ov50a_identify_module(struct ov50a *ov50a)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(ov50a->regmap, OV50A_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(ov50a->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != OV50A_CHIP_ID)
+		return dev_err_probe(ov50a->dev, -ENODEV,
+				     "chip id mismatch: expected 0x%x got 0x%llx\n",
+				     OV50A_CHIP_ID, val);
+
+	return 0;
+}
+
+static int ov50a_check_hwcfg(struct device *dev, u32 *link_freq_bitmap)
+{
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	unsigned long bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(dev, -ENODEV, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != 3) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "expected 3 C-PHY trios, got %u\n",
+				    bus_cfg.bus.mipi_csi2.num_data_lanes);
+		goto out_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       ov50a_link_freq_menu,
+				       ARRAY_SIZE(ov50a_link_freq_menu),
+				       &bitmap);
+	if (ret) {
+		dev_err_probe(dev, ret, "no supported link-frequencies\n");
+		goto out_free;
+	}
+
+	*link_freq_bitmap = bitmap;
+
+out_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int ov50a_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov50a *ov50a;
+	u32 link_freq_bitmap = 0;
+	u32 xclk_freq;
+	int ret;
+
+	ret = ov50a_check_hwcfg(dev, &link_freq_bitmap);
+	if (ret)
+		return ret;
+
+	ov50a = devm_kzalloc(dev, sizeof(*ov50a), GFP_KERNEL);
+	if (!ov50a)
+		return -ENOMEM;
+
+	ov50a->dev = dev;
+	ov50a->mode = &ov50a_modes[0];
+
+	ov50a->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov50a->regmap))
+		return dev_err_probe(dev, PTR_ERR(ov50a->regmap),
+				     "failed to init CCI regmap\n");
+
+	ov50a->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(ov50a->xclk))
+		return dev_err_probe(dev, PTR_ERR(ov50a->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(ov50a->xclk);
+	if (xclk_freq != OV50A_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk rate %u not supported (expected %u)\n",
+				     xclk_freq, OV50A_XCLK_FREQ);
+
+	ov50a->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov50a->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov50a->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(ov50a_supplies_tmpl),
+					    ov50a_supplies_tmpl,
+					    &ov50a->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	v4l2_i2c_subdev_init(&ov50a->sd, client, &ov50a_subdev_ops);
+	ov50a->sd.internal_ops = &ov50a_internal_ops;
+
+	ret = ov50a_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = ov50a_identify_module(ov50a);
+	if (ret)
+		goto err_power_off;
+
+	ret = ov50a_init_controls(ov50a, link_freq_bitmap);
+	if (ret)
+		goto err_power_off;
+
+	ov50a->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov50a->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov50a->sd.entity.ops = &ov50a_subdev_entity_ops;
+
+	ov50a->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&ov50a->sd.entity, 1, &ov50a->pad);
+	if (ret)
+		goto err_ctrl_free;
+
+	ov50a->sd.state_lock = ov50a->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&ov50a->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&ov50a->sd);
+	if (ret)
+		goto err_pm_disable;
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm_disable:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&ov50a->sd);
+err_entity_cleanup:
+	media_entity_cleanup(&ov50a->sd.entity);
+err_ctrl_free:
+	v4l2_ctrl_handler_free(&ov50a->ctrl_handler);
+err_power_off:
+	ov50a_power_off(dev);
+	return ret;
+}
+
+static void ov50a_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov50a *ov50a = to_ov50a(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&ov50a->ctrl_handler);
+
+	pm_runtime_disable(ov50a->dev);
+	if (!pm_runtime_status_suspended(ov50a->dev))
+		ov50a_power_off(ov50a->dev);
+	pm_runtime_set_suspended(ov50a->dev);
+}
+
+static const struct dev_pm_ops ov50a_pm_ops = {
+	RUNTIME_PM_OPS(ov50a_power_off, ov50a_power_on, NULL)
+};
+
+static const struct of_device_id ov50a_of_match[] = {
+	{ .compatible = "ovti,ov50a" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov50a_of_match);
+
+static struct i2c_driver ov50a_i2c_driver = {
+	.driver = {
+		.name = "ov50a",
+		.of_match_table = ov50a_of_match,
+		.pm = pm_ptr(&ov50a_pm_ops),
+	},
+	.probe = ov50a_probe,
+	.remove = ov50a_remove,
+};
+module_i2c_driver(ov50a_i2c_driver);
+
+MODULE_DESCRIPTION("OmniVision OV50A image sensor driver");
+MODULE_LICENSE("GPL");
