Subject: [PATCH] media: i2c: add OmniVision OV50A C-PHY sensor driver

Add a V4L2 CCI subdev driver for the OmniVision OV50A 50 MP 3-trio
MIPI CSI-2 C-PHY image sensor supporting 4096x3072 (30 fps), 8192x6144
(22 fps), 2048x1536 (60 fps), 1920x1080 (120 fps), and 1280x720
(240 fps) RAW10 modes.
---
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 847f007e3..ba144b4dd 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -568,6 +568,17 @@ config VIDEO_OV4689
 	  To compile this driver as a module, choose M here: the
 	  module will be called ov4689.
 
+config VIDEO_OV50A
+	tristate "OmniVision OV50A sensor support"
+	depends on GPIOLIB
+	select V4L2_CCI_I2C
+	help
+	  This is a Video4Linux2 sensor driver for the OmniVision
+	  OV50A C-PHY camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called ov50a.
+
 config VIDEO_OV5640
 	tristate "OmniVision OV5640 sensor support"
 	depends on OF
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 7be647a37..c379915d2 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -105,6 +105,7 @@ obj-$(CONFIG_VIDEO_OV2732) += ov2732.o
 obj-$(CONFIG_VIDEO_OV2735) += ov2735.o
 obj-$(CONFIG_VIDEO_OV2740) += ov2740.o
 obj-$(CONFIG_VIDEO_OV4689) += ov4689.o
+obj-$(CONFIG_VIDEO_OV50A) += ov50a.o
 obj-$(CONFIG_VIDEO_OV5640) += ov5640.o
 obj-$(CONFIG_VIDEO_OV5645) += ov5645.o
 obj-$(CONFIG_VIDEO_OV5647) += ov5647.o
