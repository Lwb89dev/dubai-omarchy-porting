+static inline struct ov32b40 *to_ov32b40(struct v4l2_subdev *sd)
+{
+	return container_of_const(sd, struct ov32b40, sd);
+}
+
+static inline u32 ov32b40_mode_hts(const struct ov32b40_mode *mode)
+{
+	return mode->ppl * OV32B40_HTS_UNIT;
+}
+
+static u32 ov32b40_mbus_code(struct ov32b40 *ov32b40)
+{
+	unsigned int idx = (ov32b40->hflip->val << 1) | ov32b40->vflip->val;
+
+	return ov32b40_mbus_codes[idx];
+}
+
+static int ov32b40_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ov32b40_supplies_tmpl),
+				    ov32b40->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(ov32b40->xclk);
+	if (ret) {
+		dev_err(dev, "failed to enable xclk: %d\n", ret);
+		goto err_reg;
+	}
+
+	fsleep(1000);
+	gpiod_set_value_cansleep(ov32b40->reset_gpio, 0);
+	fsleep(5000);
+
+	return 0;
+
+err_reg:
+	regulator_bulk_disable(ARRAY_SIZE(ov32b40_supplies_tmpl),
+			       ov32b40->supplies);
+	return ret;
+}
+
+static int ov32b40_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+
+	gpiod_set_value_cansleep(ov32b40->reset_gpio, 1);
+	clk_disable_unprepare(ov32b40->xclk);
+	regulator_bulk_disable(ARRAY_SIZE(ov32b40_supplies_tmpl),
+			       ov32b40->supplies);
+
+	return 0;
+}
+
+static int ov32b40_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov32b40 *ov32b40 = container_of(ctrl->handler, struct ov32b40,
+					      ctrl_handler);
+	const struct ov32b40_mode *mode = ov32b40->mode;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 exp_max = mode->height + ctrl->val - OV32B40_EXPOSURE_MARGIN;
+		s64 exp_val = clamp_t(s64, ov32b40->exposure->val,
+				      OV32B40_EXPOSURE_MIN, exp_max);
+
+		__v4l2_ctrl_modify_range(ov32b40->exposure,
+					 OV32B40_EXPOSURE_MIN, exp_max,
+					 OV32B40_EXPOSURE_STEP, exp_val);
+	}
+
+	if (pm_runtime_get_if_in_use(ov32b40->dev) == 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(ov32b40->regmap, OV32B40_REG_ANALOGUE_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(ov32b40->regmap, OV32B40_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(ov32b40->regmap, OV32B40_REG_VTS,
+				mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+		/* Default tuned mode registers keep 0x3821[2] asserted. */
+		ret = cci_update_bits(ov32b40->regmap,
+				      OV32B40_REG_TIMING_CTRL_21,
+				      OV32B40_FLIP_MASK,
+				      ctrl->val ? 0 : OV32B40_FLIP_MASK, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = cci_update_bits(ov32b40->regmap,
+				      OV32B40_REG_TIMING_CTRL_20,
+				      OV32B40_FLIP_MASK,
+				      ctrl->val ? OV32B40_FLIP_MASK : 0, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(ov32b40->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov32b40_ctrl_ops = {
+	.s_ctrl = ov32b40_set_ctrl,
+};
+
+static int ov32b40_init_controls(struct ov32b40 *ov32b40)
+{
+	struct v4l2_ctrl_handler *hdl = &ov32b40->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct ov32b40_mode *mode = ov32b40->mode;
+	u32 hblank, vblank, vblank_max, exp_max;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(ov32b40->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops, V4L2_CID_PIXEL_RATE,
+			  OV32B40_PIXEL_RATE, OV32B40_PIXEL_RATE, 1,
+			  OV32B40_PIXEL_RATE);
+
+	ov32b40->link_freq = v4l2_ctrl_new_int_menu(hdl, &ov32b40_ctrl_ops,
+						    V4L2_CID_LINK_FREQ, 0, 0,
+						    ov32b40_link_freq_menu);
+	if (ov32b40->link_freq)
+		ov32b40->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	hblank = ov32b40_mode_hts(mode) - mode->width;
+	ov32b40->hblank = v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops,
+					    V4L2_CID_HBLANK, hblank, hblank, 1,
+					    hblank);
+	if (ov32b40->hblank)
+		ov32b40->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts_def - mode->height;
+	vblank_max = OV32B40_VTS_MAX - mode->height;
+	ov32b40->vblank = v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops,
+					    V4L2_CID_VBLANK,
+					    OV32B40_EXPOSURE_MARGIN,
+					    vblank_max, 1, vblank);
+
+	exp_max = mode->vts_def - OV32B40_EXPOSURE_MARGIN;
+	ov32b40->exposure = v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops,
+					      V4L2_CID_EXPOSURE,
+					      OV32B40_EXPOSURE_MIN, exp_max,
+					      OV32B40_EXPOSURE_STEP, exp_max);
+
+	v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  OV32B40_ANA_GAIN_MIN, OV32B40_ANA_GAIN_MAX,
+			  OV32B40_ANA_GAIN_STEP, OV32B40_ANA_GAIN_DEFAULT);
+
+	ov32b40->hflip = v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops,
+					   V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (ov32b40->hflip)
+		ov32b40->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	ov32b40->vflip = v4l2_ctrl_new_std(hdl, &ov32b40_ctrl_ops,
+					   V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (ov32b40->vflip)
+		ov32b40->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free_hdl;
+	}
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &ov32b40_ctrl_ops, &props);
+	if (ret)
+		goto err_free_hdl;
+
+	ov32b40->sd.ctrl_handler = hdl;
+
+	return 0;
+
+err_free_hdl:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int ov32b40_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+
+	if (code->index)
+		return -EINVAL;
+
+	code->code = ov32b40_mbus_code(ov32b40);
+
+	return 0;
+}
+
+static int ov32b40_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+
+	if (fse->index >= ARRAY_SIZE(ov32b40_modes))
+		return -EINVAL;
+
+	if (fse->code != ov32b40_mbus_code(ov32b40))
+		return -EINVAL;
+
+	fse->min_width = ov32b40_modes[fse->index].width;
+	fse->max_width = ov32b40_modes[fse->index].width;
+	fse->min_height = ov32b40_modes[fse->index].height;
+	fse->max_height = ov32b40_modes[fse->index].height;
+
+	return 0;
+}
+
+static void ov32b40_update_pad_fmt(struct ov32b40 *ov32b40,
+				   const struct ov32b40_mode *mode,
+				   struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = ov32b40_mbus_code(ov32b40);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+}
+
+static int ov32b40_set_pad_format(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_format *fmt)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+	const struct ov32b40_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+
+	mode = v4l2_find_nearest_size(ov32b40_modes, ARRAY_SIZE(ov32b40_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	ov32b40_update_pad_fmt(ov32b40, mode, &fmt->format);
+	framefmt = v4l2_subdev_state_get_format(state, fmt->pad);
+	*framefmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		u32 hblank = ov32b40_mode_hts(mode) - mode->width;
+		u32 vblank = mode->vts_def - mode->height;
+		u32 vblank_max = OV32B40_VTS_MAX - mode->height;
+		u32 exp_max = mode->vts_def - OV32B40_EXPOSURE_MARGIN;
+
+		ov32b40->mode = mode;
+
+		__v4l2_ctrl_modify_range(ov32b40->hblank, hblank, hblank, 1,
+					 hblank);
+		__v4l2_ctrl_modify_range(ov32b40->vblank,
+					 OV32B40_EXPOSURE_MARGIN, vblank_max,
+					 1, vblank);
+		__v4l2_ctrl_s_ctrl(ov32b40->vblank, vblank);
+		__v4l2_ctrl_modify_range(ov32b40->exposure,
+					 OV32B40_EXPOSURE_MIN, exp_max,
+					 OV32B40_EXPOSURE_STEP, exp_max);
+	}
+
+	return 0;
+}
+
+static int ov32b40_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = ov32b40->mode->crop;
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = OV32B40_NATIVE_WIDTH;
+		sel->r.height = OV32B40_NATIVE_HEIGHT;
+		return 0;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = OV32B40_PIXEL_ARRAY_LEFT;
+		sel->r.top = OV32B40_PIXEL_ARRAY_TOP;
+		sel->r.width = OV32B40_PIXEL_ARRAY_WIDTH;
+		sel->r.height = OV32B40_PIXEL_ARRAY_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int ov32b40_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = ov32b40_modes[0].width,
+			.height = ov32b40_modes[0].height,
+		},
+	};
+
+	ov32b40_set_pad_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static int ov32b40_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+	const struct ov32b40_mode *mode = ov32b40->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(ov32b40->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_write(ov32b40->regmap, OV32B40_REG_SW_RESET,
+			OV32B40_SW_RESET_TRIGGER, NULL);
+	if (ret)
+		goto err_power_off;
+
+	fsleep(5000);
+
+	ret = cci_multi_reg_write(ov32b40->regmap, ov32b40_init_regs,
+				  ARRAY_SIZE(ov32b40_init_regs), NULL);
+	if (ret)
+		goto err_power_off;
+
+	ret = cci_multi_reg_write(ov32b40->regmap, mode->reg_list.regs,
+				  mode->reg_list.num_regs, NULL);
+	if (ret)
+		goto err_power_off;
+
+	ret = __v4l2_ctrl_handler_setup(&ov32b40->ctrl_handler);
+	if (ret)
+		goto err_power_off;
+
+	ret = cci_write(ov32b40->regmap, OV32B40_REG_STREAM_CTRL,
+			OV32B40_STREAM_ON, NULL);
+	if (ret)
+		goto err_power_off;
+
+	__v4l2_ctrl_grab(ov32b40->vflip, true);
+	__v4l2_ctrl_grab(ov32b40->hflip, true);
+
+	return 0;
+
+err_power_off:
+	pm_runtime_put_autosuspend(ov32b40->dev);
+	return ret;
+}
+
+static int ov32b40_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+
+	cci_write(ov32b40->regmap, OV32B40_REG_STREAM_CTRL,
+		  OV32B40_STREAM_OFF, NULL);
+	pm_runtime_put_autosuspend(ov32b40->dev);
+
+	__v4l2_ctrl_grab(ov32b40->vflip, false);
+	__v4l2_ctrl_grab(ov32b40->hflip, false);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops ov32b40_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops ov32b40_pad_ops = {
+	.set_fmt = ov32b40_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = ov32b40_get_selection,
+	.enum_mbus_code = ov32b40_enum_mbus_code,
+	.enum_frame_size = ov32b40_enum_frame_size,
+	.enable_streams = ov32b40_enable_streams,
+	.disable_streams = ov32b40_disable_streams,
+};
+
+static const struct v4l2_subdev_ops ov32b40_subdev_ops = {
+	.video = &ov32b40_video_ops,
+	.pad = &ov32b40_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ov32b40_internal_ops = {
+	.init_state = ov32b40_init_state,
+};
+
+static const struct media_entity_operations ov32b40_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int ov32b40_identify_module(struct ov32b40 *ov32b40)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(ov32b40->regmap, OV32B40_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(ov32b40->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != OV32B40_CHIP_ID)
+		return dev_err_probe(ov32b40->dev, -ENODEV,
+				     "chip id mismatch: expected 0x%x got 0x%llx\n",
+				     OV32B40_CHIP_ID, val);
+
+	return 0;
+}
+
+static int ov32b40_check_hwcfg(struct device *dev)
+{
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	unsigned long bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						   FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint)
+		return dev_err_probe(dev, -ENODEV, "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != 3) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "expected 3 C-PHY trios, got %u\n",
+				    bus_cfg.bus.mipi_csi2.num_data_lanes);
+		goto out_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       ov32b40_link_freq_menu,
+				       ARRAY_SIZE(ov32b40_link_freq_menu),
+				       &bitmap);
+	if (ret)
+		dev_err_probe(dev, ret, "no supported link-frequencies\n");
+
+out_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int ov32b40_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ov32b40 *ov32b40;
+	u32 xclk_freq;
+	int ret;
+
+	ret = ov32b40_check_hwcfg(dev);
+	if (ret)
+		return ret;
+
+	ov32b40 = devm_kzalloc(dev, sizeof(*ov32b40), GFP_KERNEL);
+	if (!ov32b40)
+		return -ENOMEM;
+
+	ov32b40->dev = dev;
+	ov32b40->mode = &ov32b40_modes[0];
+
+	ov32b40->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(ov32b40->regmap))
+		return dev_err_probe(dev, PTR_ERR(ov32b40->regmap),
+				     "failed to init CCI regmap\n");
+
+	ov32b40->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(ov32b40->xclk))
+		return dev_err_probe(dev, PTR_ERR(ov32b40->xclk),
+				     "failed to get xclk\n");
+
+	xclk_freq = clk_get_rate(ov32b40->xclk);
+	if (xclk_freq != OV32B40_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "xclk rate %u not supported (expected %u)\n",
+				     xclk_freq, OV32B40_XCLK_FREQ);
+
+	ov32b40->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ov32b40->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ov32b40->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(ov32b40_supplies_tmpl),
+					    ov32b40_supplies_tmpl,
+					    &ov32b40->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	v4l2_i2c_subdev_init(&ov32b40->sd, client, &ov32b40_subdev_ops);
+	ov32b40->sd.internal_ops = &ov32b40_internal_ops;
+
+	ret = ov32b40_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = ov32b40_identify_module(ov32b40);
+	if (ret)
+		goto err_power_off;
+
+	ret = ov32b40_init_controls(ov32b40);
+	if (ret)
+		goto err_power_off;
+
+	ov32b40->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	ov32b40->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	ov32b40->sd.entity.ops = &ov32b40_subdev_entity_ops;
+
+	ov32b40->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&ov32b40->sd.entity, 1, &ov32b40->pad);
+	if (ret)
+		goto err_ctrl_free;
+
+	ov32b40->sd.state_lock = ov32b40->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&ov32b40->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&ov32b40->sd);
+	if (ret)
+		goto err_pm_disable;
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_pm_disable:
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+	v4l2_subdev_cleanup(&ov32b40->sd);
+err_entity_cleanup:
+	media_entity_cleanup(&ov32b40->sd.entity);
+err_ctrl_free:
+	v4l2_ctrl_handler_free(&ov32b40->ctrl_handler);
+err_power_off:
+	ov32b40_power_off(dev);
+	return ret;
+}
+
+static void ov32b40_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov32b40 *ov32b40 = to_ov32b40(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&ov32b40->ctrl_handler);
+
+	pm_runtime_disable(ov32b40->dev);
+	if (!pm_runtime_status_suspended(ov32b40->dev))
+		ov32b40_power_off(ov32b40->dev);
+	pm_runtime_set_suspended(ov32b40->dev);
+}
+
+static const struct dev_pm_ops ov32b40_pm_ops = {
+	RUNTIME_PM_OPS(ov32b40_power_off, ov32b40_power_on, NULL)
+};
+
+static const struct of_device_id ov32b40_of_match[] = {
+	{ .compatible = "ovti,ov32b40" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov32b40_of_match);
+
+static struct i2c_driver ov32b40_i2c_driver = {
+	.driver = {
+		.name = "ov32b40",
+		.of_match_table = ov32b40_of_match,
+		.pm = pm_ptr(&ov32b40_pm_ops),
+	},
+	.probe = ov32b40_probe,
+	.remove = ov32b40_remove,
+};
+module_i2c_driver(ov32b40_i2c_driver);
+
+MODULE_DESCRIPTION("OmniVision OV32B40 image sensor driver");
+MODULE_LICENSE("GPL");
