Subject: [PATCH] arm64: dts: qcom: dubai: add AW86224 haptic vibrator node

Add compatible "awinic,aw86224" to Documentation/devicetree/bindings/input/
awinic,aw86927.yaml and wire vibrator@5a on &i2c4 for sm7325-motorola-dubai
using the existing aw86224_reset_default (gpio46) and aw86224_int_default
(gpio47) pinctrl states.
---
diff --git i/Documentation/devicetree/bindings/input/awinic,aw86927.yaml w/Documentation/devicetree/bindings/input/awinic,aw86927.yaml
index bd74b8148..264c4c8f7 100644
--- i/Documentation/devicetree/bindings/input/awinic,aw86927.yaml
+++ w/Documentation/devicetree/bindings/input/awinic,aw86927.yaml
@@ -12,7 +12,9 @@ maintainers:
 properties:
   compatible:
     oneOf:
-      - const: awinic,aw86927
+      - enum:
+          - awinic,aw86224
+          - awinic,aw86927
       - items:
           - enum:
               - awinic,aw86938
diff --git i/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi w/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi
index ef91986a1..dc751f60f 100644
--- i/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi
+++ w/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi
@@ -998,6 +998,17 @@ fsa4480_sbu_mux: endpoint {
 			};
 		};
 	};
+
+	vibrator@5a {
+		compatible = "awinic,aw86224";
+		reg = <0x5a>;
+
+		interrupts-extended = <&tlmm 47 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 46 GPIO_ACTIVE_LOW>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&aw86224_reset_default &aw86224_int_default>;
+	};
 };
 
 &ipa {
