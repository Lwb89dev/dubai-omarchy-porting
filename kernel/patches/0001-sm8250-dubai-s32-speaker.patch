Subject: [PATCH] ASoC: sm8250: use S32 for the dubai speaker backend

The Motorola dubai AW88261 speaker path uses S32_LE and a 3.072 MHz
bit clock in the Android reference. Keep the generic S16_LE/1.536 MHz
settings for other cards, but select those values for the SENARY_MI2S_RX
backend of the motorola,dubai-sndcard compatible.
---
 sound/soc/qcom/sm8250.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
index 000000000000..000000000000 100644
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -5,6 +5,7 @@
 #include <dt-bindings/sound/qcom,q6afe.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/of.h>
 #include <sound/soc.h>
 #include <sound/soc-dapm.h>
 #include <sound/pcm.h>
@@ -29,6 +30,13 @@ struct sm8250_snd_data {
 	bool jack_setup;
 };
 
+static bool sm8250_dubai_speaker(struct snd_soc_pcm_runtime *rtd)
+{
+	return of_device_is_compatible(rtd->card->dev->of_node,
+					"motorola,dubai-sndcard") &&
+		snd_soc_rtd_to_cpu(rtd, 0)->id == SENARY_MI2S_RX;
+}
+
 static int sm8250_snd_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
@@ -66,7 +74,10 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 
 	rate->min = rate->max = 48000;
 	channels->min = channels->max = 2;
-	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+	if (sm8250_dubai_speaker(rtd))
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S32_LE);
+	else
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 
 	return 0;
 }
@@ -114,7 +125,9 @@ static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 	case SENARY_MI2S_RX:
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
 		snd_soc_dai_set_sysclk(cpu_dai,
 			Q6AFE_LPASS_CLK_ID_SEN_MI2S_IBIT,
-			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			sm8250_dubai_speaker(rtd) ?
+				2 * MI2S_BCLK_RATE : MI2S_BCLK_RATE,
+			SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
 		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
 		break;
-- 
