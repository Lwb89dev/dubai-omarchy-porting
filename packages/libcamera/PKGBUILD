_pick() {
    local p="$1" f d
    shift
    for f; do
        d="$srcdir/$p/${f#$pkgdir/}"
        mkdir -p "$(dirname "$d")"
        mv "$f" "$d"
        rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
    done
}

prepare() {
    cd "$pkgbase"
    local p
    for p in \
        dubai-sensor-helpers.patch \
        0003-ipa-simple-agc-Step-faster-when-far-from-the-target-.patch \
        0005-libcamera-software_isp-add-contrast-autofocus.patch \
        0006-software_isp-Focus-on-the-frame-centre-with-statisti.patch \
        0007-software_isp-Steadier-contrast-autofocus.patch \
        0008-software_isp-Keep-exposure-white-balance-and-focus-a.patch \
        0010-software_isp-Gather-GPU-statistics-over-the-visible-.patch \
        0011-ipa-simple-agc-Add-digital-gain-past-the-sensor-s-li.patch \
        0015-ipa-simple-agc-Step-out-of-a-pinned-histogram-quickl.patch \
        0016-software_isp-debayer_egl-Destroy-the-EGL-context-whe.patch \
        0017-ipa-simple-agc-Judge-only-frames-taken-with-the-last.patch \
        0018-ipa-simple-Carry-the-exposure-over-to-another-mode-o.patch \
        0019-ipa-simple-agc-Report-the-AE-state.patch \
        0020-ipa-simple-agc-Add-exposure-compensation.patch \
        0021-ipa-simple-Take-the-sensor-mode-s-timings-at-configu.patch \
        0022-ipa-simple-agc-Support-manual-exposure-time-and-anal.patch \
        0024-software_isp-Gather-focus-statistics-over-a-window-t.patch \
        0025-ipa-simple-Focus-and-meter-on-the-application-s-wind.patch \
        0026-ipa-simple-af-Support-pausing-continuous-autofocus.patch \
        0035-ipa-simple-af-Scan-less.patch \
        0040-ipa-simple-af-Settle-less-for-fine-steps.patch \
        0005-ipa-simple-Derive-AGC-minimum-gain-step-from-sensor-.patch; do
        patch -Np1 <"../$p"
    done
    printf '%s\n' "$pkgver" >.tarball-version
}

build() {
    arch-meson "$pkgbase" build \
        -D apps-output-dng=disabled \
        -D ipas=simple \
        -D pipelines=simple \
        -D cam=disabled \
        -D documentation=disabled \
        -D gstreamer=disabled \
        -D lc-compliance=disabled \
        -D pycamera=disabled \
        -D qcam=disabled \
        -D rpi-awb-nn=disabled \
        -D test=false \
        -D tracing=disabled \
        -D v4l2=enabled \
        -D werror=false
    meson compile -C build
}

package_libcamera() {
    license=(Apache-2.0 CC0-1.0 'GPL-2.0-only WITH Linux-syscall-note'
             GPL-2.0-or-later LGPL-2.1-or-later
             'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
             'GPL-2.0-or-later WITH Linux-syscall-note OR MIT')
    depends=(glibc gnutls libcamera-ipa libelf libgcc libglvnd libpisp libstdc++
             libunwind libyaml libyuv sh systemd-libs libudev.so)
    provides=(libcamera.so libcamera-base.so)

    meson install -C build --destdir "$pkgdir"
    install -Dm644 s5kjn1.yaml "$pkgdir/usr/share/libcamera/ipa/simple/s5kjn1.yaml"
    install -Dm644 "$pkgbase/LICENSES/BSD-3-Clause.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/BSD-3-Clause.txt"
    install -Dm644 "$pkgbase/LICENSES/Linux-syscall-note.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/Linux-syscall-note.txt"
    install -Dm644 "$pkgbase/LICENSES/MIT.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/MIT.txt"
    (
        cd "$pkgdir"
        _pick libcamera-ipa usr/lib/libcamera/
        _pick libcamera-tools usr/bin/libcamera-bug-report
    )
}

package_libcamera-ipa() {
    pkgdesc+=" - signed IPA"
    license=(BSD-2-Clause CC-BY-SA-4.0 CC0-1.0 GPL-2.0-or-later LGPL-2.1-or-later)
    depends=(glibc libcamera libcamera.so libcamera-base.so libgcc libstdc++)
    options=(!strip)

    strip "$pkgname"/usr/lib/libcamera/*{.so,proxy}
    for lib in "$pkgname"/usr/lib/libcamera/*.so; do
        "$pkgbase/src/ipa/ipa-sign.sh" \
            "$(find build -type f -iname '*ipa-priv-key.pem')" "$lib" "$lib.sign"
    done
    mv "$pkgname"/* "$pkgdir"
    install -Dm644 "$pkgbase/LICENSES/BSD-2-Clause.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/BSD-2-Clause.txt"
}
