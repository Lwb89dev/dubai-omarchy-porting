#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
cd "$(dirname "$0")/.."

bash -n PKGBUILD
grep -q 'pkgrel=4.25' PKGBUILD
grep -q 'apps-output-dng=disabled' PKGBUILD
grep -q 'ipas=simple' PKGBUILD
grep -q 'pipelines=simple' PKGBUILD
grep -q 'werror=false' PKGBUILD
grep -q '_pick libcamera-tools usr/bin/libcamera-bug-report' PKGBUILD
grep -q '0005-ipa-simple-Derive-AGC-minimum-gain-step-from-sensor-.patch' PKGBUILD
grep -q 'install -Dm644 s5kjn1.yaml "$pkgdir/usr/share/libcamera/ipa/simple/s5kjn1.yaml"' PKGBUILD
grep -q 'REGISTER_CAMERA_SENSOR_HELPER("gc02m1b"' dubai-sensor-helpers.patch
grep -q 'AnalogueGainLinear{ 1, 0, 0, 1024 }' dubai-sensor-helpers.patch
grep -q 'REGISTER_CAMERA_SENSOR_HELPER("s5kjn1"' dubai-sensor-helpers.patch
grep -q 'AnalogueGainLinear{ 1, 0, 0, 1 }' dubai-sensor-helpers.patch
mapfile -t sums < <(awk '
    /^sha256sums=\(/ { in_sums=1 }
    in_sums {
        for (i=1; i<=NF; i++) {
            gsub(/sha256sums=\(|\)/, "", $i)
            if ($i ~ /^[0-9a-f]{64}$/) print $i
        }
        if (/\)$/) in_sums=0
    }
' PKGBUILD)
[[ ${#sums[@]} -eq 3 ]]
printf '%s  %s\n' \
    "${sums[0]}" dubai-sensor-helpers.patch \
    "${sums[1]}" 0005-ipa-simple-Derive-AGC-minimum-gain-step-from-sensor-.patch \
    "${sums[2]}" s5kjn1.yaml | sha256sum -c
echo 'ok libcamera carries only the dubai gain models, simple AGC gain step, and s5kjn1 tuning'
