#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
cd "$(dirname "$0")/.."
bash -n PKGBUILD
grep -q '_commit=3dbb936f0cc85a5d3f12bab12a4578d85768061c' PKGBUILD
grep -q 'license=(BSD-3-Clause)' PKGBUILD
grep -q 'SoundwireMic4EnableSeq.conf' PKGBUILD
grep -q 'depends=(alsa-ucm-conf dummystreamhack)' PKGBUILD
grep -q 'SectionDevice."Earpiece"' VoiceCall.conf
grep -q 'SectionDevice."Speaker"' VoiceCall.conf
grep -q 'SectionDevice."Mic3"' VoiceCall.conf
echo 'ok UCM package is pinned, depends on dummystreamhack, and ships Earpiece and Speaker VoiceCall devices'
