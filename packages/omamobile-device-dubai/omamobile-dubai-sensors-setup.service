[Unit]
Description=Dubai writable sensor registry for the ADSP sensor PD
# Copies persist:/sensors once (persist mounted read-only), pre-creates
# sns_reg_version, and binds the working copy at /mnt/vendor/persist.
DefaultDependencies=no
After=local-fs.target
Before=hexagonrpcd-adsp-sensorspd.service
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/omamobile/dubai-sensors-setup
RemainAfterExit=yes

[Install]
WantedBy=omamobile-dubai-modem.target
