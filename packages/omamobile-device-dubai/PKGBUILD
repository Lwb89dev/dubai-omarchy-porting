# SPDX-License-Identifier: MIT
pkgname=omamobile-device-dubai
pkgver=0.1.0
pkgrel=8
pkgdesc="Omarchy Mobile hardware-independent userspace policy for Motorola Edge 30 (dubai)"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(bash bluez systemd networkmanager openssh util-linux)
optdepends=('linux-firmware-qcom: Qualcomm firmware already covered by linux-firmware licensing'
            'alsa-ucm-conf: base UCM infrastructure; dubai profile is packaged separately'
            'modemmanager: QMI/QRTR modem support enabled by the dubai modem target'
            'rmtfs: Qualcomm remote filesystem for the modem EFS (runs read-write per the dubai drop-in)'
            'tqftpserv: QRTR TFTP service for modem readwrite items'
            'hexagonrpcd: ADSP SensorPD daemon; the udev rule fixes its device dependency')

package() {
  install -Dm644 "$startdir/device.conf" "$pkgdir/usr/share/omamobile/device.conf"
  install -Dm644 "$startdir/81-libssc-motorola-dubai.rules" \
    "$pkgdir/usr/lib/udev/rules.d/81-libssc-motorola-dubai.rules"
  install -Dm644 "$startdir/70-dubai-dma-heaps.rules" \
    "$pkgdir/usr/lib/udev/rules.d/70-dubai-dma-heaps.rules"
  install -Dm644 "$startdir/75-dubai-bluetooth.rules" \
    "$pkgdir/usr/lib/udev/rules.d/75-dubai-bluetooth.rules"
  install -Dm755 "$startdir/dubai-bluetooth-address" \
    "$pkgdir/usr/lib/omamobile/dubai-bluetooth-address"
  install -Dm644 "$startdir/omamobile-dubai-bluetooth-address@.service" \
    "$pkgdir/usr/lib/systemd/system/omamobile-dubai-bluetooth-address@.service"
  install -Dm644 "$startdir/50-dubai-libcamera-only.conf" \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-dubai-libcamera-only.conf"
  install -Dm644 "$startdir/20-usb-gadget.network" \
    "$pkgdir/usr/lib/systemd/network/20-usb-gadget.network"
  install -Dm644 "$startdir/10-omamobile-usb.conf" \
    "$pkgdir/usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf"
  install -Dm644 "$startdir/omamobile-mirrorlist" \
    "$pkgdir/etc/pacman.d/omamobile-mirrorlist"
  install -Dm644 "$startdir/75-dubai-fastrpc-systemd.rules" \
    "$pkgdir/usr/lib/udev/rules.d/75-dubai-fastrpc-systemd.rules"
  install -Dm755 "$startdir/dubai-uim-selection" \
    "$pkgdir/usr/lib/omamobile/dubai-uim-selection"
  install -Dm644 "$startdir/omamobile-dubai-uim-selection.service" \
    "$pkgdir/usr/lib/systemd/system/omamobile-dubai-uim-selection.service"
  install -Dm755 "$startdir/dubai-sensors-setup" \
    "$pkgdir/usr/lib/omamobile/dubai-sensors-setup"
  install -Dm644 "$startdir/omamobile-dubai-sensors-setup.service" \
    "$pkgdir/usr/lib/systemd/system/omamobile-dubai-sensors-setup.service"
  install -Dm644 "$startdir/omamobile-dubai-modem.target" \
    "$pkgdir/usr/lib/systemd/system/omamobile-dubai-modem.target"
  install -Dm644 "$startdir/dubai-rmtfs-rw.conf" \
    "$pkgdir/etc/systemd/system/rmtfs.service.d/dubai-rw.conf"
  install -Dm644 "$startdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -dm755 "$pkgdir/etc/systemd/system/multi-user.target.wants"
  ln -sf /usr/lib/systemd/system/omamobile-dubai-modem.target \
    "$pkgdir/etc/systemd/system/multi-user.target.wants/omamobile-dubai-modem.target"
  ln -sf /usr/lib/systemd/system/ModemManager.service \
    "$pkgdir/etc/systemd/system/multi-user.target.wants/ModemManager.service"

  # The rescue initramfs speaks ACM, but the running rootfs never offered a
  # login on the USB gadget console; wire serial-getty to ttyGS0.
  install -dm755 "$pkgdir/etc/systemd/system/getty.target.wants"
  ln -sf /usr/lib/systemd/system/serial-getty@.service \
    "$pkgdir/etc/systemd/system/getty.target.wants/serial-getty@ttyGS0.service"
}
