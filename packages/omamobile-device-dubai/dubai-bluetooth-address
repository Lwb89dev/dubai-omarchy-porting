#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail

hci=${1:?usage: dubai-bluetooth-address hciN}
[[ $hci =~ ^hci[0-9]+$ ]] || { echo "Invalid Bluetooth interface: $hci" >&2; exit 2; }
index=${hci#hci}
machine_id=$(cat /etc/machine-id)
[[ $machine_id =~ ^[0-9a-f]{32}$ ]] || { echo "Invalid machine-id" >&2; exit 1; }
hash=$(printf '%s-BT' "$machine_id" | sha256sum)
hex=0200${hash%% *}
address=${hex:0:2}:${hex:2:2}:${hex:4:2}:${hex:6:2}:${hex:8:2}:${hex:10:2}

for ((attempt = 0; attempt < 30; attempt++)); do
    info=$(btmgmt --index "$index" extinfo 2>/dev/null || true)
    if [[ $info == *"missing options: public-address"* ]]; then
        btmgmt --index "$index" public-addr "$address"
    elif [[ $info == *"addr "* && $info != *"addr 00:00:00:00:00:00"* ]]; then
        :
    elif ((attempt >= 3)); then
        btmgmt --index "$index" public-addr "$address"
    else
        sleep 1
        continue
    fi
    btmgmt --index "$index" power on
    exit 0
done

echo "Bluetooth controller did not become configurable" >&2
exit 1
