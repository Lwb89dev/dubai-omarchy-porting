#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
cd "$(dirname "$0")/.."
sh -n test/all
cmp device.conf ../../device/dubai/device.conf >/dev/null 2>&1 || {
  # The package descriptor intentionally carries only the common subset.
  grep -qx 'CODENAME=dubai' device.conf
  grep -qx 'PACKAGE=omamobile-device-dubai' device.conf
}
grep -qx 'BOOT_METHOD=ram-only' device.conf
grep -qx 'BOOT_IMAGES=""' device.conf
grep -qx 'UFS_RW=""' device.conf
grep -qx '    hardware.video-capture = required' 50-dubai-libcamera-only.conf
grep -qx '    monitor.v4l2 = disabled' 50-dubai-libcamera-only.conf
grep -q '50-dubai-libcamera-only.conf' PKGBUILD
bash -n dubai-bluetooth-address
grep -q 'missing options: public-address' dubai-bluetooth-address
grep -q 'public-addr' dubai-bluetooth-address
grep -q 'power on' dubai-bluetooth-address
grep -q 'attempt < 30' dubai-bluetooth-address
grep -q 'omamobile-dubai-bluetooth-address@%k.service' 75-dubai-bluetooth.rules
grep -q 'KERNEL=="99c000.serial".*ATTR{power/wakeup}="disabled"' 75-dubai-bluetooth.rules
grep -q 'ExecStart=/usr/lib/omamobile/dubai-bluetooth-address %i' omamobile-dubai-bluetooth-address@.service
grep -q 'hexagonrpcd-adsp-sensorspd.service' omamobile-dubai-modem.target
grep -q 'iio-sensor-proxy.service' omamobile-dubai-modem.target
grep -q 'serial-getty@ttyGS0.service' PKGBUILD
grep -q 'dubai-callaudiod' PKGBUILD
grep -q 'dms-set-operating-mode=online' dubai-uim-selection
grep -q 'zram-generator' PKGBUILD
grep -q '10-dubai-storage.rules' PKGBUILD
grep -q 'KERNEL=="sde", MODE="0000"' 10-dubai-storage.rules
grep -q '90-dubai-battery.conf' PKGBUILD
grep -qx 'UsePercentageForPolicy=false' 90-dubai-battery.conf
bash -n dubai-qbootctl-mark-successful
grep -q 'dubai-qbootctl-mark-successful' PKGBUILD
grep -q 'omamobile-dubai-qbootctl-mark-successful.service' PKGBUILD
grep -q 'blockdev --setro "\$lun_a" "\$lun_b"' dubai-qbootctl-mark-successful
grep -q '\[ \$disk_a != "sde" && \$disk_b != "sde" \]' dubai-qbootctl-mark-successful || grep -Fq '$disk_a != "sde"' dubai-qbootctl-mark-successful
! grep -q 'enable.*omamobile-dubai-qbootctl-mark-successful' PKGBUILD
! grep -q 'omamobile-dubai-qbootctl-mark-successful.service' PKGBUILD || ! grep -q 'wants/omamobile-dubai-qbootctl-mark-successful.service' PKGBUILD
grep -q 'ENV{ACCEL_MOUNT_MATRIX}+="-1, 0, 0; 0, -1, 0; 0, 0, 1"' 81-libssc-motorola-dubai.rules
grep -q 'id = "/base/soc@0/cci@ac4a000/i2c-bus@1/sensor@56"' omacam-lenses.toml
grep -q 'omacam-lenses.toml' PKGBUILD
grep -q 'omamobile-dubai-omacam-lenses.service' PKGBUILD
echo 'ok dubai package is RAM-only, selects libcamera, configures a local Bluetooth address, protects non-userdata UFS partitions, wants the sensor stack, wires call audio, opens the gadget getty, guards A/B slot marking, and depends on zram-generator'
