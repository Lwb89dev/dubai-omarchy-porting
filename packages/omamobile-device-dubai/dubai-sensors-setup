#!/bin/bash
# SPDX-License-Identifier: MIT
# Seed an independent Linux registry; never mount or write Android persist.
set -euo pipefail

source_dir=/usr/share/qcom/sm7325/Motorola/dubai
state_dir=/var/lib/dubai-hexagonrpc

if [[ -e $state_dir || -L $state_dir ]]; then
    [[ -d $state_dir/sensors/persist/registry && ! -L $state_dir ]] || {
        echo "Incomplete or unsafe sensor registry: $state_dir" >&2
        exit 1
    }
    exit 0
fi

[[ -d $source_dir/sensors/registry && -d $source_dir/sensors/config &&
   -f $source_dir/sensors/sns_reg.conf && -d $source_dir/socinfo ]] || {
    echo "Dubai sensor firmware tree missing: $source_dir" >&2
    exit 1
}
if find "$source_dir/sensors" "$source_dir/socinfo" -type l -print -quit | grep -q .; then
    echo "Sensor firmware tree contains symlinks; refusing to seed registry" >&2
    exit 1
fi

staging=$(mktemp -d /var/lib/.dubai-hexagonrpc.XXXXXXXX)
trap 'rm -rf -- "$staging"' EXIT
install -d -m 0755 "$staging/sensors/persist/registry"
cp -r --no-preserve=ownership "$source_dir/sensors/registry/." "$staging/sensors/persist/registry/"
cp -r --no-preserve=ownership "$source_dir/sensors/config" "$staging/sensors/"
cp --no-preserve=ownership "$source_dir/sensors/sns_reg.conf" "$staging/sensors/"
cp -r --no-preserve=ownership "$source_dir/socinfo" "$staging/"
chmod 0755 "$staging" "$staging/sensors" "$staging/sensors/persist"
chown -R fastrpc:fastrpc "$staging/sensors/persist"
mv -T -- "$staging" "$state_dir"
trap - EXIT
