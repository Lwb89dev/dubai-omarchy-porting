# SPDX-License-Identifier: GPL-2.0-only
# Keep pmaports' Clang thin-LTO and BTF settings for a like-for-like reference build.
CONFIG_LOCALVERSION="-dubai"
# CONFIG_LOCALVERSION_AUTO is not set

# RAM-only diagnostic USB gadget: no modules are needed before PID 1.
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# Preserve kernel diagnostics across a reset; the DTS provides ramoops.
CONFIG_PSTORE_RAM=y

# UFW's stock rules use these matches and targets.
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_IP6_NF_MATCH_RT=m

# pacman 7 sandboxes its download hooks with Landlock; without it every
# install needs --disable-sandbox. CONFIG_LSM already lists landlock.
CONFIG_SECURITY_LANDLOCK=y

# Suspend bring-up instrumentation: /sys/power/pm_test, pm_debug_messages
# and pm_print_times, to root-cause the premature s2idle wake (M8).
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# Allow gcc-sc7280, gpu_cc-sc7280, and disp_cc-sc7280 sync_state() to run after
# deferred_probe_timeout even though chosen:framebuffer (no simpledrm) and
# 3d6a000.gmu (bound via of_find_device_by_node) never bind a platform_driver,
# so genpd->stay_on clears on disp_cc_mdss_core_gdsc, mmnoc TBU, UFS, and USB GDSCs.
CONFIG_FW_DEVLINK_SYNC_STATE_TIMEOUT=y

# Enable rear main (OV50A) and front (OV32B40) C-PHY camera sensor modules.
CONFIG_VIDEO_OV50A=m
CONFIG_VIDEO_OV32B40=m
