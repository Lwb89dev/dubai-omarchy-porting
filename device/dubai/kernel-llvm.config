# SPDX-License-Identifier: GPL-2.0-only
# Keep pmaports' Clang thin-LTO and BTF settings for a like-for-like reference build.
CONFIG_LOCALVERSION="-dubai"
# CONFIG_LOCALVERSION_AUTO is not set

# RAM-only diagnostic USB gadget: no modules are needed before PID 1.
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# Preserve kernel diagnostics across a reset; the DTS provides ramoops.
CONFIG_PSTORE_RAM=y

# UFW's stock rules use these matches and targets.
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_IP6_NF_MATCH_RT=m

# pacman 7 sandboxes its download hooks with Landlock; without it every
# install needs --disable-sandbox. CONFIG_LSM already lists landlock.
CONFIG_SECURITY_LANDLOCK=y
