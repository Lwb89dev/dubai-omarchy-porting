# SPDX-License-Identifier: GPL-2.0-only
# Applied over pmaports' linux-postmarketos-qcom-sc7280 7.2.9 configuration.
# GCC host build; pmaports uses Clang thin-LTO and BTF.
# CONFIG_LTO is not set
# CONFIG_LTO_CLANG is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
CONFIG_LOCALVERSION="-dubai"
# CONFIG_LOCALVERSION_AUTO is not set

# RAM-only diagnostic USB gadget: no modules are needed before PID 1.
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# Preserve kernel diagnostics across a reset; the DTS provides ramoops.
CONFIG_PSTORE_RAM=y

# Both board DTS files build, but only the selected panel may be packed.
# panel-novatek-nt37701.o is obj-m in the SC7280 tree (no Kconfig symbol).

# pacman 7 sandboxes its download hooks with Landlock; without it every
# install needs --disable-sandbox. CONFIG_LSM already lists landlock.
CONFIG_SECURITY_LANDLOCK=y
