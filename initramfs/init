#!/bin/sh
# SPDX-License-Identifier: MIT
# Motorola dubai early init. Keeps every UFS disk/partition read-only unless
# /etc/omamobile-ufs-rw explicitly allowlists userdata on sde.

export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PS1='dubai-rescue# '

say() {
    echo "dubai-init: $*" | tee /dev/kmsg
}

fail_closed_shell() {
    say "$*; remaining in RAM with storage read-only"
    while true; do
        setsid -c sh </dev/tty1 >/dev/tty1 2>&1
        sleep 1
    done
}

mount -t proc proc /proc || fail_closed_shell "cannot mount proc"
mount -t sysfs sysfs /sys || fail_closed_shell "cannot mount sysfs"
mount -t devtmpfs devtmpfs /dev || fail_closed_shell "cannot mount devtmpfs"
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mkdir -p /run/diagnostics
mount -t configfs configfs /sys/kernel/config 2>/dev/null || true

# Fail-closed storage allowlist: only "userdata" on sde is ever permitted.
UFS_RW=""
if [ -s /etc/omamobile-ufs-rw ]; then
    read -r ufs_rw_raw </etc/omamobile-ufs-rw
    if [ "$ufs_rw_raw" = "userdata" ]; then
        UFS_RW="userdata"
        say "storage guard allowlist: userdata on sde (all other UFS partitions stay read-only)"
    else
        say "ignoring invalid /etc/omamobile-ufs-rw '$ufs_rw_raw'; keeping all storage read-only"
    fi
fi

ufs_partname() {
    sed -n 's/^PARTNAME=//p' "$1/uevent" 2>/dev/null
}

storage_ro_pass() {
    local s name part
    for s in /sys/block/sd* /sys/block/sd*/sd*; do
        [ -r "$s/ro" ] || continue
        name=${s##*/}
        [ -b "/dev/$name" ] || continue
        if [ "$UFS_RW" = "userdata" ]; then
            if [ "$name" = sde ]; then
                rm -f /dev/sde
                continue
            fi
            part=$(ufs_partname "$s")
            if [ "${name%%[0-9]*}" = sde ] && [ "$part" = userdata ]; then
                continue
            fi
        fi
        blockdev --setro "/dev/$name" 2>/dev/null || say "FAILED to set /dev/$name read-only"
    done
}

ufs_unguarded() {
    local s name part ro
    for s in /sys/block/sd* /sys/block/sd*/sd*; do
        [ -r "$s/ro" ] || continue
        name=${s##*/}
        if [ "$UFS_RW" = "userdata" ] && [ "$name" = sde ]; then
            continue
        fi
        read -r ro <"$s/ro"
        [ "$ro" = 0 ] || continue
        part=$(ufs_partname "$s")
        if [ "$UFS_RW" = "userdata" ] && [ "${name%%[0-9]*}" = sde ] && [ "$part" = userdata ]; then
            continue
        fi
        echo "$name${part:+ ($part)}"
    done
}

storage_ro_pass
(while true; do storage_ro_pass; sleep 1; done) &
storage_ro_loop_pid=$!

hostname dubai-rescue
board=$(tr '\0' '\n' </proc/device-tree/compatible 2>/dev/null | head -n 1)
if [ "$board" != "motorola,dubai" ]; then
    fail_closed_shell "unexpected board '${board:-unknown}'"
fi

collect_diagnostics() {
    uname -a >/run/diagnostics/uname.txt
    cat /proc/cmdline >/run/diagnostics/cmdline.txt
    cat /proc/device-tree/model >/run/diagnostics/model.txt 2>/dev/null
    dmesg >/run/diagnostics/dmesg.txt
    cat /proc/partitions >/run/diagnostics/partitions.txt
    ls -l /dev/disk/by-partlabel >/run/diagnostics/partition-labels.txt 2>/dev/null || true
    cp /proc/device-tree/compatible /run/diagnostics/compatible.txt 2>/dev/null || true
}
release=$(cat /proc/sys/kernel/osrelease)
if [ -d "/usr/lib/modules/$release" ]; then
    for module in evdev spi-geni-qcom panel-novatek-nt37701 goodix_berlin_core goodix_berlin_spi; do
        modprobe "$module" 2>/dev/null || say "module $module not loaded"
    done
fi

collect_diagnostics
say "Linux $release on $(cat /proc/device-tree/model 2>/dev/null)"

# CDC network plus an ACM shell. No storage gadget is ever created.
gadget=/sys/kernel/config/usb_gadget/g1
setup_usb() {
    local net_function=ncm
    if [ -s /etc/omamobile-usb-net-function ]; then
        read -r net_function </etc/omamobile-usb-net-function
    fi
    case "$net_function" in ncm|rndis) ;; *) say "invalid USB network function"; return 1 ;; esac
    mkdir -p "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
    echo 0x1d6b >"$gadget/idVendor"
    echo 0x0104 >"$gadget/idProduct"
    echo "Omarchy Mobile" >"$gadget/strings/0x409/manufacturer"
    echo "Motorola Edge 30 diagnostic" >"$gadget/strings/0x409/product"
    echo "dubai-rescue" >"$gadget/strings/0x409/serialnumber"
    echo "$net_function + ACM" >"$gadget/configs/c.1/strings/0x409/configuration"
    mkdir -p "$gadget/functions/$net_function.usb0" "$gadget/functions/acm.GS0"
    ln -s "$gadget/functions/$net_function.usb0" "$gadget/configs/c.1/"
    ln -s "$gadget/functions/acm.GS0" "$gadget/configs/c.1/"

    local udc attempt
    for attempt in $(seq 1 30); do
        udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
        [ -n "$udc" ] && break
        sleep 1
    done
    if [ -z "$udc" ]; then
        say "no USB device controller; diagnostics remain on the local console"
        return 1
    fi
    echo "$udc" >"$gadget/UDC" || return 1
    say "USB gadget bound to $udc"
}
console_loop_pid=""
if setup_usb; then
    ip link set lo up
    for attempt in $(seq 1 10); do
        [ -d /sys/class/net/usb0 ] && break
        sleep 1
    done
    if ip addr add 172.16.42.1/24 dev usb0 2>/dev/null; then
        ip link set usb0 up
        if [ -s /root/.ssh/authorized_keys ]; then
            dropbear -R -E -s -g -p 22 2>/dev/null && say "SSH available at 172.16.42.1 (public key only)"
        else
            say "no SSH public key packed; use the USB serial shell"
        fi
    else
        say "usb0 did not appear; no network diagnostics available"
    fi
    (while true; do setsid getty -n -l /bin/sh 115200 ttyGS0 vt100; sleep 1; done) &
    console_loop_pid=$!
fi

grow_root() {
    local dev=$1 info part_bytes fs_bytes blocks bsize
    grep -qw omamobile.noresize /proc/cmdline && return 0
    command -v dumpe2fs >/dev/null 2>&1 || return 0
    command -v resize2fs >/dev/null 2>&1 || return 0
    info=$(dumpe2fs -h "$dev" 2>/dev/null)
    [ "$(echo "$info" | sed -n 's/^Filesystem volume name: *//p')" = omamobile-root ] || return 0
    blocks=$(echo "$info" | sed -n 's/^Block count: *//p')
    bsize=$(echo "$info" | sed -n 's/^Block size: *//p')
    part_bytes=$(blockdev --getsize64 "$dev" 2>/dev/null)
    [ -n "$blocks" ] && [ -n "$bsize" ] && [ -n "$part_bytes" ] || return 0
    fs_bytes=$((blocks * bsize))
    [ $((part_bytes - fs_bytes)) -gt 67108864 ] || return 0
    say "growing ext4 root on $dev ($((fs_bytes >> 20)) MiB -> $((part_bytes >> 20)) MiB)"
    e2fsck -f -p "$dev" >/dev/null 2>&1 || true
    if resize2fs "$dev" >/run/resize2fs.log 2>&1; then
        say "ext4 root grown on $dev"
    else
        say "resize2fs failed on $dev; continuing at current size"
    fi
}

switch_to_newroot() {
    local open
    storage_ro_pass
    open=$(ufs_unguarded)
    if [ -n "$open" ]; then
        say "ABORT switch_root: unguarded writable storage: $(echo "$open" | tr '\n' ' ')"
        umount /newroot 2>/dev/null || true
        return 1
    fi
    kill "$storage_ro_loop_pid" 2>/dev/null || true
    killall dropbear 2>/dev/null || true
    [ -n "$console_loop_pid" ] && kill "$console_loop_pid" 2>/dev/null || true
    killall getty 2>/dev/null || true
    exec switch_root /newroot /sbin/init
}

boot_userdata() {
    grep -qw omamobile.initramfs /proc/cmdline && return 1
    [ -s /etc/omamobile-root-device ] || return 1
    read -r root_mode </etc/omamobile-root-device
    [ "$root_mode" = "userdata" ] || return 1
    [ "$UFS_RW" = "userdata" ] || { say "userdata boot requires UFS_RW=userdata"; return 1; }

    local attempt s dev=""
    for attempt in $(seq 1 20); do
        for s in /sys/block/sde/sde*; do
            [ -r "$s/uevent" ] || continue
            if grep -qx 'PARTNAME=userdata' "$s/uevent" 2>/dev/null; then
                dev="/dev/${s##*/}"
                break
            fi
        done
        [ -b "$dev" ] && break
        dev=""
        sleep 1
    done
    [ -b "$dev" ] || { say "userdata partition on sde not found"; return 1; }
    [ "$(cat "/sys/block/sde/${dev#/dev/}/ro" 2>/dev/null)" = 0 ] || {
        say "userdata ($dev) is read-only; refusing boot"
        return 1
    }
    if command -v e2fsck >/dev/null 2>&1; then
        e2fsck -p "$dev" >/dev/null 2>&1 || true
    fi
    grow_root "$dev"
    mkdir -p /newroot
    mount -t ext4 -o rw,relatime "$dev" /newroot || { say "cannot mount $dev"; return 1; }
    if [ ! -x /newroot/sbin/init ] && [ ! -x /newroot/usr/lib/systemd/systemd ]; then
        say "no init/systemd on $dev"
        umount /newroot
        return 1
    fi
    say "switching to Arch rootfs on internal $dev (userdata); all other UFS partitions remain read-only"
    switch_to_newroot
}

boot_userdata || true

if [ -s /etc/omamobile-nbd-server ]; then
    nbd_server=$(cat /etc/omamobile-nbd-server)
    modprobe nbd 2>/dev/null || say "module nbd not loaded"
    nbd_ready=false
    for attempt in $(seq 1 90); do
        if nbd-client "$nbd_server" -N omamobile /dev/nbd0; then
            nbd_size=$(blockdev --getsize64 /dev/nbd0 2>/dev/null || echo 0)
            if [ "$nbd_size" -gt 0 ]; then
                nbd_ready=true
                break
            fi
            nbd-client -d /dev/nbd0 2>/dev/null || true
        fi
        sleep 1
    done
    mkdir -p /newroot
    if $nbd_ready && mount /dev/nbd0 /newroot; then
        say "switching to Arch rootfs over USB NBD; internal storage remains read-only"
        switch_to_newroot
    fi
    say "NBD root unavailable; remaining in diagnostic shell"
fi

(sleep 5; collect_diagnostics; say "diagnostics refreshed in /run/diagnostics") &

# Never exit PID 1 and never panic/reboot because USB is unavailable.
while true; do
    setsid -c sh </dev/tty1 >/dev/tty1 2>&1
    sleep 1
done
